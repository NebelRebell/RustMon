# ============================================================
# RustAdmin Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# --- Required ---
# Your Steam API key: https://steamcommunity.com/dev/apikey
STEAM_API=your-steam-api-key-here

# --- Port (optional, default: 8080) ---
# The host port the web UI will be accessible on.
RUSTADMIN_PORT=8080

# --- Redis (optional, defaults to no password) ---
# Password for Redis. Leave empty for no auth.
REDIS_PASSWORD=

# Cache TTL in seconds (default: 604800 = 7 days)
CACHE_TTL=604800

# --- Discord Bot (optional) ---
# Leave DISCORD_BOT_TOKEN empty to disable Discord integration.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_STATUS_CHANNEL_ID=
# Oxide/uMod group to assign when a player links via !linksteam
DISCORD_OXIDE_GROUP=discord

# --- VPN Detection (optional) ---
# Set to false to disable VPN checks entirely.
VPN_CHECK_ENABLED=true
# Auto-kick players detected as VPN (requires RCON integration).
VPN_AUTO_KICK=false

# --- Elastic APM (optional, disabled by default) ---
APM_ENABLED=no
APM_SERVICE_NAME=rustadmin-service
APM_SERVER_URL=http://localhost:8200
APM_API_KEY=
