# ============================================================
# RustMon (Nebelbank Edition) - Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- Ports ---
# Port the frontend is exposed on (default: 8080)
RUSTADMIN_PORT=8080

# --- Redis ---
# Redis password (leave empty for no auth)
REDIS_PASSWORD=

# Cache TTL in seconds (default: 7 days)
CACHE_TTL=604800

# --- Steam ---
# Steam Web API key (required for player lookups)
STEAM_API=your_steam_api_key_here

# --- JWT Authentication ---
# Secret key for signing JWT tokens - CHANGE THIS IN PRODUCTION!
JWT_SECRET=rustmon-dev-secret-change-in-production

# Default admin user credentials (created on first start if no users exist)
ADMIN_EMAIL=admin@rustmon.local
ADMIN_PASSWORD=change-me-now

# --- Discord Bot ---
# Bot token from Discord Developer Portal
DISCORD_BOT_TOKEN=

# Channel ID for Rust↔Discord chat bridge
DISCORD_CHANNEL_ID=

# Channel ID for server status embeds (every 5 minutes)
DISCORD_STATUS_CHANNEL_ID=

# Oxide group to assign when player links Steam via !linksteam
DISCORD_OXIDE_GROUP=discord

# --- OAuth (Discord) ---
# From Discord Developer Portal → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- OAuth (Google) ---
# From Google Cloud Console → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- URLs ---
# Public URL of the frontend (used for OAuth redirects)
FRONTEND_URL=http://localhost:8080

# Public URL of the backend API (used for OAuth callbacks)
API_URL=http://localhost:3000

# --- VPN Detection ---
# Enable VPN/proxy detection via ip-api.com (true/false)
VPN_CHECK_ENABLED=true

# Automatically kick players detected as using VPN (true/false)
VPN_AUTO_KICK=false
